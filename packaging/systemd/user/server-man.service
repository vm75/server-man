[Unit]
Description=server-man Linux server manager (user scope)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/local/bin/server-man -config %h/.config/server-man/server-man.yaml
Restart=on-failure
RestartSec=3s
TimeoutStopSec=60s
KillMode=mixed

[Install]
WantedBy=default.target
