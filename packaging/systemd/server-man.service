[Unit]
Description=server-man Linux server manager
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/
ExecStart=/usr/local/bin/server-man -config /etc/server-man/config.json
Restart=on-failure
RestartSec=3s
TimeoutStopSec=60s
KillMode=mixed
StateDirectory=server-man
StateDirectoryMode=0700
ConfigurationDirectory=server-man
ConfigurationDirectoryMode=0700

[Install]
WantedBy=multi-user.target
